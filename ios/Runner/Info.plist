	<array>
		<string>_jellyfin._tcp</string>
		<string>_emby._tcp</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
