// DreamPlayer.storekit
// StoreKit Configuration File
//
// Products defined below. Xcode auto-registers them for the local StoreKit sandbox.
// To test: Product → Scheme → Edit Scheme → Run → Options → StoreKit Configuration → DreamPlayer.storekit
//
// IMPORTANT — product IDs must match the live App Store Connect products
// exactly, because `paywall_sheet.dart` queries these IDs by name:
//   dp_premium_monthly_2026, dp_premium_yearly_2026, dp_premium_lifetime_2026
// (An earlier draft of this file used `advanced_*` IDs, which never existed in
// ASC. That was harmless at runtime because the file only feeds the local
// Xcode sandbox, but it made this config a misleading reference — always
// confirm against `lib/screens/paywall_sheet.dart` before editing.)

configurations {
    defaultConfiguration = Release

    configurations {
        Debug {}
        Release {}
    }
}

products {
    // ── Subscriptions (auto-renewable) ──

    dp_premium_monthly_2026 {
        type: autoRenewableSubscription
        displayName: "Premium Monthly"
        description: "Unlock all premium features — billed monthly."
        subscriptionGroupID: dp_premium_group
        duration: 1 month
        price: INR 199.00
    }

    dp_premium_yearly_2026 {
        type: autoRenewableSubscription
        displayName: "Premium Yearly"
        description: "Unlock all premium features — billed annually."
        subscriptionGroupID: dp_premium_group
        duration: 1 year
        price: INR 1499.00
    }

    // ── Non-Consumable (one-time purchase) ──

    dp_premium_lifetime_2026 {
        type: nonConsumable
        displayName: "Premium Lifetime"
        description: "Unlock all premium features forever — one-time purchase."
        price: INR 4999.00
    }
}

subscriptionGroups {
    dp_premium_group {
        displayName: "Premium"
    }
}
