# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# Session scratch (logcat captures, surfaceflinger dumps, one-off probes)
.tmp_dart/
sf_*.txt
*.pid

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Local secrets (never commit): API keys read at build time via
# `--dart-define-from-file=.env` (see `.env.example` for the shape)
.env

# libsmb2's LGPL-2.1 relinking material: generated by ios/libsmb2_build.sh
# at build time (the .o files are Mach-O objects, not portable sources).
assets/libsmb2-objects/*.zip
assets/libsmb2-objects/obj/
ios/Runner/libsmb2/build/

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/build

# Live API credentials — NEVER commit these. jwt.txt/login.json held a real
# TheTVDB JWT (apikey + account id, valid to ~2026-10-28) and were tracked from
# commit 5fd77c3 in a PUBLIC repo. They are stored in the Android Keystore /
# iOS Keychain at runtime instead (TheTvdbCredentialStore), so nothing in the
# build needs them here.
jwt.txt
login.json
*.jwt
*.auth.json
