<?xml version="1.0" encoding="utf-8"?>
<!-- Alternate adaptive launcher icon: red (issue #23).
     Mirrors ic_launcher.xml, which stays the default. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground>
        <inset
            android:drawable="@drawable/ic_launcher_foreground_red"
            android:inset="16%" />
    </foreground>
</adaptive-icon>
