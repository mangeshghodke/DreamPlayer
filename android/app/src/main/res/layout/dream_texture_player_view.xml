<?xml version="1.0" encoding="utf-8"?>
<!-- PlayerView with a TextureView (SurfaceTexture) sink, used ONLY while the
     "Hardware SDR tone-mapping" setting is ON (issue #55/#64): Qualcomm's
     c2.qti.hevc.decoder ignores KEY_COLOR_TRANSFER_REQUEST while rendering
     straight into a SurfaceView (hardware overlay), but honours it when its
     output sink is a SurfaceTexture - verified on a OnePlus Pad 2 against
     mpv-infinity ("codec output transfer=3 (SDR (709))"). The SurfaceView
     path remains the default so native HDR/DV passthrough is untouched when
     the setting is OFF. -->
<com.dreamplayer.app.ForcedAspectPlayerView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:use_controller="false" />
