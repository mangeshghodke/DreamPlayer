<?xml version="1.0" encoding="utf-8"?>
<!-- Exclude credential-bearing shared preferences from Android auto-backup. -->
<full-backup-content>
    <exclude domain="sharedpref" path="dreamplayer.webdavServers.xml"/>
    <exclude domain="sharedpref" path="dreamplayer.webdavSecrets.xml"/>
    <exclude domain="sharedpref" path="dreamplayer.theTvdbSecrets.xml"/>
    <exclude domain="sharedpref" path="FlutterSharedPreferences.xml"/>
</full-backup-content>
