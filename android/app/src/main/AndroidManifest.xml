<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Required by multicast_dns (Jellyfin/Emby mDNS discovery) on Wi-Fi. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO"/>
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"/>
    <!-- Background playback: foreground media service + notification controls -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- Android TV: show on leanback launchers; required=false keeps the APK
         installable on phones/tablets. -->
    <uses-feature android:name="android.software.leanback" android:required="false"/>
    <!-- Without this, Android TV devices filter the app out. -->
    <uses-feature android:name="android.software.touchscreen" android:required="false"/>
    <application
        android:label="DreamPlayer"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:largeHeap="true"
        android:usesCleartextTraffic="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- Open video files from file explorers / "Open with" menus.
                 Two broad filters (content + file) with every common video/
                 audio container MIME. File managers assign container MIMEs that
                 differ by vendor (CX uses video/x-matroska, application/mpeg,
                 application/octet-stream, ...), so we cover the whole matrix. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme=""/>
                <data android:scheme="content"/>
                <data android:scheme="file"/>
                <data android:scheme="http"/>
                <data android:scheme="https"/>
                <data android:mimeType="video/*"/>
                <data android:mimeType="audio/*"/>
                <data android:mimeType="application/x-matroska"/>
                <data android:mimeType="application/matroska"/>
                <data android:mimeType="video/x-matroska"/>
                <data android:mimeType="audio/x-matroska"/>
                <data android:mimeType="application/mpeg"/>
                <data android:mimeType="video/mpeg"/>
                <data android:mimeType="video/mp2t"/>
                <data android:mimeType="video/x-mp2t"/>
                <data android:mimeType="video/x-msvideo"/>
                <data android:mimeType="video/x-ms-wmv"/>
                <data android:mimeType="video/x-ms-asf"/>
                <data android:mimeType="video/quicktime"/>
                <data android:mimeType="video/x-m4v"/>
                <data android:mimeType="video/x-flv"/>
                <data android:mimeType="application/vnd.apple.mpegurl"/>
                <data android:mimeType="application/x-mpegurl"/>
                <data android:mimeType="application/vnd.rn-realmedia"/>
                <data android:mimeType="application/x-shockwave-flash"/>
                <data android:mimeType="audio/octet-stream"/>
                <data android:mimeType="application/octet-stream"/>
            </intent-filter>
        </activity>
        <!-- Launcher icon aliases (issue #23).
             ===================================================================
             DO NOT disable MainActivity. Every alias below has
             android:targetActivity=".MainActivity", and an alias whose target
             is disabled CANNOT BE LAUNCHED: it just makes the icon dead,
             which is exactly what happened the first time this was written.
             That is why MainActivity carries no MAIN/LAUNCHER filter either:
             it stays permanently enabled (so it is a valid target, and so
             "Open with" always resolves) while the visible launcher icon is
             owned entirely by whichever alias is enabled.
             Exactly one alias is enabled at a time, and IconSwitcher enables
             the new one BEFORE disabling the others, so an interrupted toggle
             can never leave zero launcher entries. ensureLaunchable() also
             re-enables the default alias on every launch as a backstop.
             =================================================================== -->
        <activity-alias
            android:name=".MainActivityAltDefault"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:icon="@mipmap/ic_launcher">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
                <!-- Appear on Android TV / Fire TV launchers too. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme=""/>
                <data android:scheme="content"/>
                <data android:scheme="file"/>
                <data android:scheme="http"/>
                <data android:scheme="https"/>
                <data android:mimeType="video/*"/>
                <data android:mimeType="audio/*"/>
                <data android:mimeType="application/x-matroska"/>
                <data android:mimeType="application/matroska"/>
                <data android:mimeType="video/x-matroska"/>
                <data android:mimeType="audio/x-matroska"/>
                <data android:mimeType="application/mpeg"/>
                <data android:mimeType="video/mpeg"/>
                <data android:mimeType="video/mp2t"/>
                <data android:mimeType="video/x-mp2t"/>
                <data android:mimeType="video/x-msvideo"/>
                <data android:mimeType="video/x-ms-wmv"/>
                <data android:mimeType="video/x-ms-asf"/>
                <data android:mimeType="video/quicktime"/>
                <data android:mimeType="video/x-m4v"/>
                <data android:mimeType="video/x-flv"/>
                <data android:mimeType="application/vnd.apple.mpegurl"/>
                <data android:mimeType="application/x-mpegurl"/>
                <data android:mimeType="application/vnd.rn-realmedia"/>
                <data android:mimeType="application/x-shockwave-flash"/>
                <data android:mimeType="audio/octet-stream"/>
                <data android:mimeType="application/octet-stream"/>
            </intent-filter>
        </activity-alias>
        <!-- Alternate launcher icons (issue #23). Each is the same activity
             with a different android:icon, toggled by IconSwitcher.kt.

             They carry a FULL copy of MainActivity's intent filters, because
             setComponentEnabledSetting() disables the entire component, not
             just its launcher entry, so whichever one is enabled must still be
             able to receive "Open with" intents.

             All four are declared enabled="false" so a fresh install shows
             exactly one icon. IconSwitcher enables the chosen one BEFORE
             disabling the others, so there is never a moment with no launchable
             component, and ensureLaunchable() repairs an interrupted toggle on
             the next launch. -->

        <activity-alias
            android:name=".MainActivityAltMark"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:icon="@mipmap/ic_launcher_mark">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
                <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme=""/>
                <data android:scheme="content"/>
                <data android:scheme="file"/>
                <data android:scheme="http"/>
                <data android:scheme="https"/>
                <data android:mimeType="video/*"/>
                <data android:mimeType="audio/*"/>
                <data android:mimeType="application/x-matroska"/>
                <data android:mimeType="application/matroska"/>
                <data android:mimeType="video/x-matroska"/>
                <data android:mimeType="audio/x-matroska"/>
                <data android:mimeType="application/mpeg"/>
                <data android:mimeType="video/mpeg"/>
                <data android:mimeType="video/mp2t"/>
                <data android:mimeType="video/x-mp2t"/>
                <data android:mimeType="video/x-msvideo"/>
                <data android:mimeType="video/x-ms-wmv"/>
                <data android:mimeType="video/x-ms-asf"/>
                <data android:mimeType="video/quicktime"/>
                <data android:mimeType="video/x-m4v"/>
                <data android:mimeType="video/x-flv"/>
                <data android:mimeType="application/vnd.apple.mpegurl"/>
                <data android:mimeType="application/x-mpegurl"/>
                <data android:mimeType="application/vnd.rn-realmedia"/>
                <data android:mimeType="application/x-shockwave-flash"/>
                <data android:mimeType="audio/octet-stream"/>
                <data android:mimeType="application/octet-stream"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".MainActivityAltRed"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:icon="@mipmap/ic_launcher_red">
            <meta-data
